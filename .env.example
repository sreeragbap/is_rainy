# ── Weather ──────────────────────────────────────────────────────────────────
# None required. IsRainy uses Open-Meteo, which needs no API key for either the
# forecast or the geocoding endpoint. The core answer therefore holds zero
# credentials and cannot break because a key expired or a quota ran out.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project settings → API. The anon key is safe to expose to the browser;
# it is scoped by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlsY3Rucmtwanp5Yml5c3Z6dWVjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU0OTU0MjEsImV4cCI6MjEwMTA3MTQyMX0.e48XIQEhFDKpM8yiICPk3HZX2I-GIKVfGFADvgLHMjc

# ── Database (Prisma → Supabase Postgres) ────────────────────────────────────
# Project settings → Database → Connection string.
# DATABASE_URL: transaction pooler (port 6543) — used by the app at runtime.
# DIRECT_URL:   direct connection (port 5432) — used by `prisma migrate`.
# Only recent searches and favourites need these. Without them the app still
# answers "is it raining?" — it just cannot remember your places.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
